#!/bin/sh
# config/hooks/normal/0500-calamares-setup.chroot
set -e

echo "Configuring Linux-Libre kernel mirrors..."
echo "deb http://trisquel.org aruba main" > /etc/apt/sources.list.d/libre-kernel.list
apt-get update || true

echo "Applying production permissions for Calamares deployment layer..."
chmod +x /usr/local/bin/calamares-package-deploy
